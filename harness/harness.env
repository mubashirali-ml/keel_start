# Harness settings. A real environment variable with the same name overrides this file,
# e.g.  SUPERVISOR_MODE=auto bash scripts/harness_args.sh plan

# human: the Supervisor's plan stops for your approval before any builder starts, and
#        builder questions about WHAT the product should do come to you.
# auto:  plan and build run straight through; the Supervisor decides everything itself.
SUPERVISOR_MODE=human

# Which waves the deliver stage runs (comma-separated). Wave 0 is the foundation.
WAVES=0,1

# The plan check rejects a plan whose wave 1 has fewer parallel tickets than this.
MIN_PARALLEL_BUILDERS=5
