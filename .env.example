# Example configuration (ADR-0021, ADR-0022, ADR-0038). Copy to .env for local development.
# .env is read only outside production; in production every value comes from the environment.
# This file holds no real secrets: fill in your own values.
#
#   development (default): fake LLM unless a key is set, console email, fake payments,
#                          embedded job worker, text logs, an insecure dev SECRET_KEY
#   test:                  every fake, fixed test SECRET_KEY (pytest, recorded runs, the reliable demo)
#   production:            refuses to start (one ConfigError listing every problem) unless real
#                          providers, Stripe, SMTP, PostgreSQL, https URLs and a strong SECRET_KEY are set

# ---------------------------------------------------------------- core
# development | test | production
APP_ENV=development
# Public URL of the app: links in emails and Stripe redirects (production: https://...)
APP_BASE_URL=http://localhost:8000
# Product name shown to customers in pages, emails and PDFs (ADR-0039)
BRAND_NAME=Charterly
# HMAC key for CSRF and tokens; production needs at least 32 random characters
SECRET_KEY=
# 1 = demo mode: "act as founder" switcher and the test checkout page (never in production)
DEMO_MODE=0
# 1 = fakes for every outside service: LLM, domains, hosting, email, payments
LAUNCH_FAKE_SERVICES=0
# Fix "today" (YYYY-MM-DD) for recorded runs and the demo
LAUNCH_TODAY=

# ---------------------------------------------------------------- LLM (ADR-0022)
# fake | claude_code | anthropic | deepseek | groq | openai-compatible
# Unset: ANTHROPIC_API_KEY -> anthropic, else DEEPSEEK_API_KEY -> deepseek, else GROQ_API_KEY -> groq, else fake.
# claude_code uses YOUR personal Claude Code login: own machine only, never production.
LLM_PROVIDER=
# Default model for the provider (anthropic default: claude-opus-5-5)
LLM_MODEL=
# Per-agent models: LLM_MODEL_<AGENT> with AGENT = MANAGER, LAW, NAME, WEBSITE, QA, GUIDE
# LLM_MODEL_NAME=claude-haiku-5-5
# LLM_MODEL_QA=claude-haiku-5-5
# Effort for the anthropic provider (low | medium | high); per agent: LLM_EFFORT_<AGENT>
LLM_EFFORT=medium
# LLM_EFFORT_QA=low
# Request timeout in seconds
LLM_TIMEOUT_S=60
# Retries inside the provider SDK on transient errors
LLM_MAX_RETRIES=2
# Anthropic API key (production)
ANTHROPIC_API_KEY=
# 1 = use Anthropic's server-side refusal fallback for Opus-family models
ANTHROPIC_REFUSAL_FALLBACK=1
# DeepSeek API key
DEEPSEEK_API_KEY=
# Groq API key
GROQ_API_KEY=
# Key and base URL for LLM_PROVIDER=openai-compatible (or to override a preset)
LLM_API_KEY=
LLM_BASE_URL=
# Path to the Claude Code CLI; unset: newest VS Code extension binary, else `claude` on PATH
CLAUDE_CODE_PATH=
# Claude Code CLI timeout in seconds
CLAUDE_CODE_TIMEOUT_S=120

# ---------------------------------------------------------------- services (ADR-0011)
# Domain availability checks: rdap (live, free) | fake
DOMAIN_CHECKER=rdap
# Website hosting: netlify | fake | none; unset: netlify when NETLIFY_AUTH_TOKEN is set, else none
HOSTING_PROVIDER=
# Netlify personal access token for live deploys
NETLIFY_AUTH_TOKEN=

# ---------------------------------------------------------------- email (ADR-0029)
# smtp | console | fake (production: smtp)
EMAIL_PROVIDER=console
# Sender address (production: a verified sending domain)
EMAIL_FROM=no-reply@localhost
# JSONL mailbox file for browser runs and the demo (never in production)
EMAIL_DROP_FILE=
# SMTP server (any provider: Postmark, Amazon SES, Resend, Mailgun, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 1 = STARTTLS
SMTP_STARTTLS=1

# ---------------------------------------------------------------- payments (ADR-0030, ADR-0038)
# stripe | fake; development default: fake unless STRIPE_SECRET_KEY is set (production: stripe)
PAYMENTS_PROVIDER=
# Stripe secret key: sk_test_... for staging, sk_live_... only in production
STRIPE_SECRET_KEY=
# Stripe webhook endpoint signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Stripe price ids for the paid plans (price_...)
STRIPE_PRICE_LAUNCH_MONTHLY=
STRIPE_PRICE_LAUNCH_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
# 1 = offer yearly prices ("two months free"); 0 hides yearly everywhere (yearly price ids then not required)
BILLING_YEARLY_ENABLED=1
# Plan amounts: each line overrides one number (defaults shown). Prices in cents.
# PLAN_FREE_PRICE_MONTH_CENTS=0
# PLAN_FREE_PRICE_YEAR_CENTS=0
# PLAN_FREE_MAX_COMPANIES=1
# PLAN_FREE_AI_MESSAGES=300
# PLAN_LAUNCH_PRICE_MONTH_CENTS=2900
# PLAN_LAUNCH_PRICE_YEAR_CENTS=29000
# PLAN_LAUNCH_MAX_COMPANIES=3
# PLAN_LAUNCH_AI_MESSAGES=2000
# PLAN_TEAM_PRICE_MONTH_CENTS=7900
# PLAN_TEAM_PRICE_YEAR_CENTS=79000
# PLAN_TEAM_MAX_COMPANIES=15
# PLAN_TEAM_AI_MESSAGES=10000
# Support address for the help menu's "Contact support" (required in production)
SUPPORT_EMAIL=

# ---------------------------------------------------------------- data and jobs (ADR-0027, ADR-0028)
# Database URL: SQLite for development and tests, postgresql+psycopg://user:pass@host/db in production
# (DATABASE_URL is also accepted)
LAUNCH_DB_URL=sqlite:///./launch_agents.db
# 1 = run the job worker inside the API process (development default); production runs a separate worker
JOBS_EMBEDDED_WORKER=1
# PostgreSQL URL for the postgres-marked tests (CI only)
# LAUNCH_TEST_POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/launch_test

# ---------------------------------------------------------------- security (ADR-0033)
# Session idle and absolute expiry in days
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
# Allowed browser origins, comma separated (production: the app origin, https only)
LAUNCH_CORS_ORIGINS=http://localhost:5173
# Hops of X-Forwarded-For to trust (0 when the app is not behind a proxy)
TRUSTED_PROXY_COUNT=0
# 1 = rate limits on auth, email and AI endpoints
RATE_LIMITS_ENABLED=1

# ---------------------------------------------------------------- operations (ADR-0034)
# text | json (production default: json)
LOG_FORMAT=text
LOG_LEVEL=INFO
# Error reporting hook "package.module:function"; unset: errors are logged
ERROR_REPORTER=
# Built frontend served at / (SPA fallback to index.html)
FRONTEND_DIST=frontend/dist
